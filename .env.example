# Clé API MiniMax (https://platform.minimax.io)
MINIMAX_API_KEY=
# Modèle et point d'accès (API compatible OpenAI)
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_BASE_URL=https://api.minimax.io/v1
# Profondeur de raisonnement : low | medium | high | xhigh | max (plus élevé = plus lent)
MINIMAX_REASONING_EFFORT=medium
MINIMAX_MAX_TOKENS=12000
# Relecture de forme des réponses (mots parasites du modèle) : true par défaut
MINIMAX_PROOFREAD=true

# Jeton protégeant POST /api/ingest (relance de l'archivage des programmes)
ADMIN_TOKEN=

# Secret de l'instance SearXNG (docker compose)
SEARXNG_SECRET=

# Hors Docker uniquement : URL d'une instance SearXNG et répertoire d'archivage
# SEARXNG_URL=http://localhost:8080
# DATA_DIR=./storage

# Port publié sur l'hôte
# APP_PORT=3000
